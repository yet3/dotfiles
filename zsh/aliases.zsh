alias ls="eza --icons"
alias lls="eza -1 -l --icons"

alias ..="cd .."
alias cd..="cd .."

alias home="cd ~"
alias config="cd ~/.config"
alias dev="cd ~/dev/"

alias vim="nvim"
alias nvim-old="NVIM_APPNAME=NvimOld nvim"

alias tmux-e="cd $HOME/.config/tmux/ && nvim ./tmux.conf"
alias .tmux="cd $HOME/.config/tmux/"

alias nvim-e="cd $HOME/.config/nvim && nvim ./init.lua"
alias .nvim="cd $HOME/.config/nvim"

alias zsh-r="source $ZBIN"
alias zsh-e="cd $HOME/.config/zsh && nvim ./init.zsh"
alias .zsh="cd $ZDIR"

